{
  "expo": {
    "name": "Expo Split View Example (Nested)",
    "slug": "expo-split-view-example-nested",
    "scheme": "exposplitviewnested",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-split-view",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
